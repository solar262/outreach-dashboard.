{
  "version": 2,
  "cleanUrls": true,
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/saas-server/server.js" },
    { "source": "/api/webhooks/stripe", "destination": "/saas-server/server.js" },
    { "source": "/api/search-leads", "destination": "/saas-server/server.js" },
    { "source": "/api/roast", "destination": "/saas-server/server.js" },
    { "source": "/roaster", "destination": "/roast.html" },
    { "source": "/validate/(.*)", "destination": "/validate/agent.html" },
    { "source": "/(.*)", "destination": "/universal-agent.html" }
  ],
  "functions": {
    "saas-server/server.js": {
      "runtime": "vercel-node@latest"
    }
  }
}
